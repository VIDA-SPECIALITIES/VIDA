---
/**
 * Our Portfolio → The VIDA Collection, with the 360° bottle viewer.
 * Ported from reference/vida-collection-360.html (2026-10-21). Uses the site's
 * own fonts, tokens and header; three.js is lazy-loaded from npm when the
 * section approaches the viewport (no CDN, no keys, no remote config).
 */
import BottleCard from './BottleCard.astro';
import ProductDisclaimer from './ProductDisclaimer.astro';
import { VIDA_VARIANTS } from '../data/vida-variants';
---

<section class="vida-collection bg-[#f6f7f4]" data-collection aria-labelledby="collection-title">
  <div class="container-site py-section">
    <div class="grid items-end gap-y-10 md:grid-cols-12" data-reveal>
      <div class="md:col-span-8">
        <p class="eyebrow text-green">The VIDA Collection</p>
        <h2 id="collection-title" class="mt-6 text-display-xl">
          <span class="block">Three expressions.</span>
          <span class="block text-green italic">One living curve.</span>
        </h2>
      </div>
      <p class="max-w-[22rem] text-lead md:col-span-4 md:pb-3">
        Different needs. One disciplined foundation. One Living Curve bottle carries a complete hydration system
        designed for modern living.
      </p>
    </div>

    <div class="mt-14 mb-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3.5 md:mt-18">
      <div class="inline-flex rounded-full border border-navy/15 bg-paper p-[3px]" role="group" aria-label="Bottle finish">
        <button type="button" data-sleeve="on" aria-pressed="true" class="seg-btn">With sleeve</button>
        <button type="button" data-sleeve="off" aria-pressed="false" class="seg-btn">Bare glass</button>
      </div>
      <p id="collection-hint" class="m-0 text-[0.8125rem] text-navy/75" data-hint>
        Hover a bottle to turn it. Drag sideways to rotate, or up and down to see the cap and base.
      </p>
    </div>

    <div class="mx-auto grid max-w-[520px] gap-6 lg:max-w-none lg:grid-cols-3 lg:gap-[clamp(18px,2.4vw,40px)]">
      {
        VIDA_VARIANTS.map((v) => (
          <BottleCard variant={v.key} index={v.index} description={v.card.description} sub={v.card.sub} />
        ))
      }
    </div>

    <div class="eyebrow mt-10 flex flex-col gap-3 border-t border-navy/15 pt-6 text-[0.625rem] text-navy/70 sm:flex-row sm:justify-between">
      <span>Signature Collection · One Living Curve</span>
      <span>Concepts under development · sleeves are sample concepts</span>
      <span>Abuja · Nigeria</span>
    </div>

    <ProductDisclaimer class="mt-12 max-w-3xl" />
  </div>
</section>

<style is:global>
  /* State classes are toggled by src/scripts/bottle-viewer.ts on elements it creates,
     so these rules are global but scoped under .vida-collection. */
  .vida-collection .seg-btn {
    font: 500 0.75rem/1 var(--font-sans);
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-navy) 75%, transparent);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 0.625rem 1rem;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s;
  }
  .vida-collection .seg-btn[aria-pressed='true'] {
    background: var(--color-navy);
    color: var(--color-mist);
  }
  .vida-collection .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .vida-collection .ready .stage canvas { opacity: 1; }
  .vida-collection .poster { transition: opacity 0.6s ease 0.3s; }
  .vida-collection .ready .poster { opacity: 0; }
  .vida-collection .stage.dragging { cursor: grabbing; }
  .vida-collection .bottle-card:focus-visible .stage,
  .vida-collection .vida-bottle-card:focus-visible .stage { outline: 2px solid currentColor; outline-offset: 4px; }
  .vida-collection .orbit .track {
    fill: none;
    stroke: var(--color-navy);
    stroke-opacity: 0.13;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .vida-collection .orbit .trace {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .vida-collection .turning .orbit .trace { opacity: 0.9; }
  .vida-collection .degrees { opacity: 0; transition: opacity 0.4s ease; }
  .vida-collection .turning .degrees { opacity: 1; }
  .vida-collection .fallback [data-view] { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .vida-collection .orbit .trace,
    .vida-collection .degrees,
    .vida-collection .stage canvas,
    .vida-collection .poster { transition: none; }
  }
</style>

<script>
  import type { CollectionHandle } from '../scripts/bottle-viewer';

  // three.js (~600 KB) is only fetched when the section approaches the viewport.
  let handle: CollectionHandle | null = null;
  let io: IntersectionObserver | null = null;

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-collection]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = 'pending';
    io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io?.disconnect();
        io = null;
        const { mountCollection } = await import('../scripts/bottle-viewer');
        if (!root.isConnected) return;
        handle = await mountCollection(root);
        root.dataset.mounted = 'true';
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(root);
  }

  function teardown() {
    io?.disconnect();
    io = null;
    handle?.dispose();
    handle = null;
  }

  // The site does not use <ClientRouter />, so a normal page load calls setup().
  // If view transitions are added later, these events take over automatically.
  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);
</script>
