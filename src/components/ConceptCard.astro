---
/**
 * Portfolio showcase card: the Artifact 002 render on a tinted panel with a
 * concept label laid over the bottle (HTML, so it stays crisp and carries only
 * approved wording), then the approved line and description.
 * Colours are design proposals pending approval (docs/source-asset-inventory.md).
 */
import { Image } from 'astro:assets';
// 360° viewer layers (scripts/brand/rotation_layers.py): per-concept base bottle
// with the emboss removed (cap colours are DESIGN PROPOSALS, client 2026-10-20)
// plus one shared emboss layer that travels around the body on rotation.
import baseImmune from '../assets/renders/vida-a002-base-immune.png';
import baseRadiance from '../assets/renders/vida-a002-base-radiance.png';
import baseEdge from '../assets/renders/vida-a002-base-edge.png';
import emboss from '../assets/renders/vida-a002-emboss.png';
const bases = { immune: baseImmune, radiance: baseRadiance, edge: baseEdge };

interface Props {
  id: string;
  index: string;
  /** Short name, e.g. IMMUNE (shown after "VIDA"). */
  name: string;
  line: string;
  text: string;
  tone: 'immune' | 'radiance' | 'edge';
}

const { id, index, name, line, text, tone } = Astro.props;

const tones = {
  immune: { accent: 'text-green', rule: 'bg-green', border: 'border-green', tint: 'bg-immune-tint', ring: 'border-green/25' },
  radiance: { accent: 'text-clay-deep', rule: 'bg-clay-deep', border: 'border-clay-deep', tint: 'bg-radiance-tint', ring: 'border-clay-deep/25' },
  edge: { accent: 'text-edge', rule: 'bg-edge', border: 'border-edge', tint: 'bg-edge-tint', ring: 'border-edge/25' },
}[tone];
---

<article id={id} class="flex scroll-mt-28 flex-col border border-navy/10 bg-paper" data-reveal data-spin-card>
  <!-- Visual -->
  <div class:list={['relative aspect-[4/5] overflow-hidden', tones.tint]}>
    <span class:list={['absolute top-5 right-6 font-display text-xl tabular-nums', tones.accent]}>{index}</span>
    <span aria-hidden="true" class="spin-hint eyebrow absolute bottom-4 left-5 z-10 flex items-center gap-2 text-[0.5625rem] text-navy/70">
      <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.2"
        ><ellipse cx="8" cy="8" rx="6.5" ry="2.6"></ellipse><path d="M12.2 4.6 14.5 5.4 13.6 7.6"></path></svg
      >
      <span class="hint-hover">360° · Hover to rotate</span><span class="hint-touch">360° · Tap to rotate</span>
    </span>
    <div
      aria-hidden="true"
      class:list={['absolute top-1/2 left-1/2 h-[80%] w-[62%] -translate-x-1/2 -translate-y-1/2 rounded-[50%] border', tones.ring]}
    >
    </div>
    <div class="absolute inset-x-0 top-[6%] bottom-[6%] flex justify-center">
      <div class="relative aspect-[1536/2304] h-full" data-spin>
        <Image
          src={bases[tone]}
          alt=""
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
          class="block h-full w-full"
        />
        <!-- Emboss on the glass surface; positioned in render % (see rotation_layers.py) -->
        <Image
          src={emboss}
          alt=""
          widths={[90, 170]}
          sizes="(min-width: 1024px) 3vw, 10vw"
          loading="lazy"
          data-emboss
          class="absolute block h-[20.833%] w-[11.068%] max-w-none will-change-transform"
          style="left: 44.922%; top: 48.177%"
        />
        <!-- Concept label over the bottle body (bottle spans x ≈ 20–80% of the render) -->
        <div
          class:list={[
            'absolute top-[72%] left-1/2 w-[74%] -translate-x-1/2 border-l-[3px] bg-paper/90 px-[6%] py-[4.5%] shadow-[0_6px_20px_-12px_rgba(14,26,42,0.35)] backdrop-blur-[2px]',
            tones.border,
          ]}
        >
          <div class="flex items-baseline justify-between gap-2">
            <span class:list={['font-display text-[0.7rem] tracking-[0.3em]', tones.accent]}>VIDA</span>
            <span class="text-[0.5rem] tracking-[0.18em] whitespace-nowrap text-navy/70 uppercase">Concept</span>
          </div>
          <p class:list={['mt-[6%] font-display text-[clamp(1rem,1.9vw,1.375rem)] leading-none', tones.accent]}>
            {name}
          </p>
          <div class="mt-[7%] h-px bg-navy/15"></div>
        </div>
      </div>
    </div>
  </div>

  <div class:list={['h-[3px]', tones.rule]}></div>

  <!-- Text -->
  <div class="flex flex-1 flex-col gap-5 p-7 md:p-8">
    <p class:list={['eyebrow', tones.accent]}>VIDA / Concept {index}</p>
    <h3 class="font-display text-display-md leading-none tracking-[0.02em]">{name}</h3>
    <p class="text-sm font-medium tracking-[0.04em]">{line}</p>
    <p class="max-w-[24rem] text-navy/85">{text}</p>
  </div>
</article>

<style>
  .hint-touch { display: none; }
  @media (hover: none) { .hint-hover { display: none; } .hint-touch { display: inline; } }
  @media (prefers-reduced-motion: reduce) { .spin-hint { display: none; } }
</style>

<script>
  /*
   * 360° viewer. The bottle is axially symmetric under fixed studio light, so
   * rotating it leaves silhouette and highlights in place; only the embossed
   * "VIDA" travels around the body. We move that layer on the cylinder:
   * x = R·sinθ, scaleX = cosθ (negative = mirrored, seen from behind through
   * the glass, so dimmer). transform/opacity only: no layout shift.
   */
  const R_OVER_W = 15.104 / 11.068; // body radius ÷ emboss width (render %)
  const OFFSET = (50.456 - 49.935) / 11.068; // emboss centre vs bottle axis
  const TURN = Math.PI * 2;
  const SPEED = TURN / 3.6; // one revolution per 3.6 s at full speed
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Mode = 'idle' | 'spin' | 'settle';
  for (const card of document.querySelectorAll<HTMLElement>('[data-spin-card]')) {
    const layer = card.querySelector<HTMLElement>('[data-emboss]');
    if (!layer || reduce) continue;
    let angle = 0, vel = 0, mode: Mode = 'idle', stopAt = Infinity, raf = 0, last = 0;

    const draw = () => {
      const s = Math.sin(angle), c = Math.cos(angle);
      const tx = (R_OVER_W * s - OFFSET * (1 - c)) * 100;
      layer.style.transform = `translateX(${tx.toFixed(2)}%) scaleX(${c.toFixed(4)})`;
      layer.style.opacity = (c >= 0 ? 0.2 + 0.8 * c : 0.32 * -c).toFixed(3);
    };
    const tick = (t: number) => {
      const dt = Math.min(0.05, (t - last) / 1000 || 0.016); last = t;
      if (mode === 'spin') {
        vel += (SPEED - vel) * Math.min(1, dt * 2.5); // ease in
        angle += vel * dt;
        if (angle >= stopAt) mode = 'settle';
      } else if (mode === 'settle') {
        const end = Math.ceil(angle / TURN - 1e-6) * TURN; // finish facing front
        const rest = end - angle;
        vel = Math.max(Math.min(vel, rest * 3), 0.35); // ease out, never reverse
        angle = Math.min(end, angle + vel * dt);
        if (end - angle < 1e-3) { angle = 0; vel = 0; mode = 'idle'; stopAt = Infinity; draw(); raf = 0; return; }
      }
      draw();
      raf = requestAnimationFrame(tick);
    };
    const run = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); } };
    const spin = (once = false) => { mode = 'spin'; stopAt = once ? angle + TURN * 0.82 : Infinity; run(); };
    const settle = () => { if (mode !== 'idle') { mode = 'settle'; run(); } };

    card.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' || e.pointerType === 'pen') spin(); });
    card.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' || e.pointerType === 'pen') settle(); });
    card.addEventListener('pointerup', (e) => { if (e.pointerType === 'touch') (mode === 'spin' ? settle() : spin()); });

    // Touch devices: one turn when the card comes into view; pause off-screen.
    const coarse = window.matchMedia('(hover: none)').matches;
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) { if (mode !== 'idle') { cancelAnimationFrame(raf); raf = 0; angle = 0; vel = 0; mode = 'idle'; draw(); } }
      else if (coarse && entry.intersectionRatio >= 0.6 && mode === 'idle') spin(true);
    }, { threshold: [0, 0.6] }).observe(card);
  }
</script>
