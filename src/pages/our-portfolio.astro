---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import BottleConcept from '../components/BottleConcept.astro';
import ProductDisclaimer from '../components/ProductDisclaimer.astro';
import RailLabel from '../components/RailLabel.astro';
import NextPage from '../components/NextPage.astro';
import CollectionSection from '../components/CollectionSection.astro';
import ConceptSpecifications from '../components/ConceptSpecifications.astro';

---

<SiteLayout
  title="Our Portfolio"
  description="One hydration system. Purposefully designed. Products shown are currently under development."
>
  <PageHero page="Our Portfolio" heading="One hydration system. Purposefully designed.">
    <ProductDisclaimer />
  </PageHero>

  <!-- The VIDA Collection: 360° bottle viewer -->
  <CollectionSection />

  <ConceptSpecifications />

  <!-- Base Water Standard -->
  <section class="border-t border-mist-deep">
    <div class="container-site grid items-end gap-y-16 py-section md:grid-cols-12">
      <div class="md:col-span-6 md:pb-16" data-reveal>
        <RailLabel>Foundation</RailLabel>
        <h2 class="mt-8 text-display-lg">The VIDA Base Water Standard</h2>
        <p class="mt-8 max-w-[30rem] text-lead">
          Every VIDA functional product begins with the same uncompromising foundation: water engineered for purity,
          consistency and exceptional drinking quality.
        </p>
      </div>
      <BottleConcept class="md:col-span-4 md:col-start-9" />
    </div>
  </section>

  <NextPage current="Our Portfolio" />
</SiteLayout>
