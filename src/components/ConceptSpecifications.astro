---
/**
 * Our Portfolio → Concept Specifications (#specifications).
 * A: introduction · B: shared foundation · C: concept cards + desktop table · disclaimer.
 * All content comes from src/data/concepts.ts.
 */
import { Image } from 'astro:assets';
import render from '../assets/renders/vida-artifact-002-render.png';
import {
  CONCEPTS,
  CONCEPT_FOUNDATION,
  CONCEPT_SPEC_DISCLAIMER,
  CONCEPT_TONES,
  type Concept,
} from '../data/concepts';

type Row = { label: string; value: (c: Concept) => string; muted?: (c: Concept) => boolean };
const tableRows: Row[] = [
  { label: 'Concept direction', value: (c) => c.spec.direction },
  { label: 'Formulation focus', value: (c) => c.spec.formulationShort, muted: (c) => !!c.spec.formulationPending },
  { label: 'Intended positioning', value: (c) => c.spec.positioningShort },
  { label: 'Water standard', value: () => 'VIDA Base Water Standard' },
  { label: 'Bottle platform', value: () => 'Artifact 002' },
  { label: 'Development status', value: () => 'Under development' },
];
---

<section id="specifications" class="scroll-mt-24 border-t border-mist-deep" aria-labelledby="spec-heading">
  <div class="container-site py-section">
    <!-- A · Introduction -->
    <header class="grid items-start gap-y-8 lg:grid-cols-12" data-reveal>
      <p class="eyebrow flex items-center gap-4 text-clay-deep lg:col-span-3 lg:pt-5">
        <span aria-hidden="true" class="h-px w-8 shrink-0 bg-clay"></span>Concept specifications
      </p>
      <div class="lg:col-span-9">
        <h2 id="spec-heading" class="max-w-[16em] text-display-lg">
          <span class="block">Three concepts.</span>
          <span class="block text-green italic">One considered foundation.</span>
        </h2>
        <p class="mt-8 max-w-[36rem] text-lead">
          Each VIDA concept is being developed around a distinct hydration proposition, united by a shared water
          standard and the Artifact 002 bottle platform. Explore the intended direction, formulation focus and
          development status of each concept.
        </p>
      </div>
    </header>

    <!-- B · Shared foundation -->
    <div class="mt-20 grid overflow-hidden border border-navy/10 bg-paper md:mt-28 lg:grid-cols-12" data-reveal>
      <div class="relative hidden bg-mist lg:col-span-3 lg:block" aria-hidden="true">
        <div class="absolute inset-x-0 top-8 bottom-0 flex justify-center">
          <Image
            src={render}
            alt=""
            widths={[240, 360, 480]}
            sizes="18vw"
            loading="lazy"
            class="h-[118%] w-auto max-w-none object-contain"
          />
        </div>
      </div>
      <div class="p-8 md:p-12 lg:col-span-9 lg:p-14">
        <h3 class="font-display text-display-md">One foundation. Three expressions.</h3>
        <p class="mt-4 max-w-[34rem] text-navy/85">
          IMMUNE, RADIANCE and EDGE share the same product-development foundation: one water standard and one bottle
          platform.
        </p>
        <dl class="mt-10 grid gap-y-8 border-t border-navy/15 pt-8 sm:grid-cols-3 sm:gap-x-8">
          {
            CONCEPT_FOUNDATION.map((item, i) => (
              <div class:list={[i > 0 && 'sm:border-l sm:border-navy/15 sm:pl-8']}>
                <dt class="eyebrow text-navy/70">{item.label}</dt>
                <dd class="mt-3 font-display text-[1.375rem] leading-snug">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- C · Concept comparison -->
    <div class="mt-24 md:mt-32">
      <div class="grid items-end gap-y-6 md:grid-cols-12" data-reveal>
        <h3 class="font-display text-display-md md:col-span-7">Distinct directions. Shared design principles.</h3>
      </div>

      <ul class="mt-12 grid gap-6 lg:grid-cols-3" role="list">
        {
          CONCEPTS.map((c) => {
            const t = CONCEPT_TONES[c.id];
            return (
              <li
                class="group flex flex-col border border-navy/10 bg-paper transition-shadow duration-500 ease-calm hover:shadow-[0_18px_40px_-28px_rgba(14,26,42,0.35)]"
                data-reveal
              >
                <div class:list={['h-[3px]', t.bg]} />
                <article class="flex flex-1 flex-col p-7 md:p-9 lg:p-7 xl:p-9" aria-labelledby={`spec-${c.id}`}>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <p class:list={['eyebrow whitespace-nowrap', t.text]}>Concept {c.index}</p>
                    <p class="text-[0.6875rem] tracking-[0.14em] whitespace-nowrap text-navy/70 uppercase">Under development</p>
                  </div>
                  <h4 id={`spec-${c.id}`} class="mt-6 font-display text-[1.75rem] leading-none lg:text-[1.5rem] xl:text-[2.125rem] tracking-[0.03em] whitespace-nowrap">
                    {c.name}
                  </h4>
                  <p class:list={['mt-4 font-display text-xl italic lg:min-h-[3.5rem]', t.text]}>“{c.line}”</p>

                  <dl class="mt-8 flex-1 divide-y divide-navy/10 border-t border-navy/15">
                    <div class="py-4">
                      <dt class="eyebrow text-navy/70">Concept type</dt>
                      <dd class="mt-1.5">{c.spec.type}</dd>
                    </div>
                    <div class="py-4">
                      <dt class="eyebrow text-navy/70">Formulation direction</dt>
                      <dd class:list={['mt-1.5', c.spec.formulationPending && 'text-navy/70 italic']}>
                        {c.spec.formulation}
                      </dd>
                    </div>
                    <div class="py-4">
                      <dt class="eyebrow text-navy/70">Intended positioning</dt>
                      <dd class="mt-1.5">{c.spec.positioning}</dd>
                    </div>
                  </dl>
                </article>
              </li>
            );
          })
        }
      </ul>

      <!-- Detailed comparison: desktop only (display:none below lg also hides it from assistive tech) -->
      <div class="mt-20 hidden lg:block" data-reveal>
        <table class="w-full table-fixed border-collapse text-left">
          <caption class="eyebrow mb-6 text-left text-navy/70">Side-by-side comparison</caption>
          <colgroup>
            <col class="w-[22%]" /><col /><col /><col />
          </colgroup>
          <thead>
            <tr class="border-b border-navy/25">
              <th scope="col" class="eyebrow pb-4 font-medium text-navy/70">Specification</th>
              {
                CONCEPTS.map((c) => (
                  <th scope="col" class="pb-4 pl-8 font-normal">
                    <span class="flex items-center gap-3">
                      <span aria-hidden="true" class:list={['size-2 rounded-full', CONCEPT_TONES[c.id].bg]} />
                      <span class="font-display text-[1.375rem] tracking-[0.03em]">{c.name}</span>
                    </span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              tableRows.map((row) => (
                <tr class="border-b border-navy/10 transition-colors duration-300 hover:bg-paper/70">
                  <th scope="row" class="eyebrow py-5 pr-4 align-top font-medium text-navy/80">
                    {row.label}
                  </th>
                  {CONCEPTS.map((c) => (
                    <td
                      class:list={[
                        'py-5 pl-8 align-top text-[0.9375rem] leading-relaxed text-pretty',
                        row.muted?.(c) && 'text-navy/70 italic',
                      ]}
                    >
                      {row.value(c)}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Development disclaimer -->
    <p class="mt-14 max-w-[46rem] border-l-2 border-clay pl-5 text-sm leading-relaxed text-navy/75" data-reveal>
      {CONCEPT_SPEC_DISCLAIMER}
    </p>
  </div>
</section>
